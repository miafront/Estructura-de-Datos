#include <iostream>
using namespace std;

int main() {
    const int N = 7;
    int v[N];

    // Leer los 7 números
    cout << "Ingrese 7 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Buscar el menor
    int menor = v[0];
    for (int i = 1; i < N; i++) {
        if (v[i] < menor) {
            menor = v[i];
        }
    }

    // Mostrar el resultado
    cout << "El menor es: " << menor << endl;

    return 0;
}
