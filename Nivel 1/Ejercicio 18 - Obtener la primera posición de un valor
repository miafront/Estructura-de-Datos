#include <iostream>
using namespace std;

int main() {
    const int N = 10;
    int v[N];
    int X;

    // Leer los 10 números
    cout << "Ingrese 10 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Leer el valor a buscar
    cout << "Ingrese el valor a buscar: ";
    cin >> X;

    // Buscar la primera posición de X
    int posicion = -1;
    for (int i = 0; i < N; i++) {
        if (v[i] == X) {
            posicion = i;
            break;
        }
    }

    // Mostrar el resultado
    if (posicion != -1) {
        cout << "El valor " << X << " aparece en el indice " << posicion << "." << endl;
    } else {
        cout << "El valor " << X << " no aparece en el arreglo." << endl;
    }

    return 0;
}
