// EJERCICIO 19: Contar apariciones de un valor
// Enunciado: Leer 10 enteros y un valor X. Contar cuántas veces aparece X.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 10;
    int v[N];
    int X;

    cout << "Ingrese 10 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese el valor a contar: ";
    cin >> X;

    int contador = 0;
    for (int i = 0; i < N; i++) {
        if (v[i] == X) {
            contador++;
        }
    }

    cout << "El valor " << X << " aparece " << contador << " veces." << endl;

    return 0;
}
