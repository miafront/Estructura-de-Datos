#include <iostream>
using namespace std;

int main() {
    const int N = 10;
    int v[N];
    int contador = 0;

    // Leer los 10 números
    cout << "Ingrese 10 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Contar los pares
    for (int i = 0; i < N; i++) {
        if (v[i] % 2 == 0) {
            contador++;
        }
    }

    // Mostrar el resultado
    cout << "Cantidad de pares: " << contador << endl;

    return 0;
}
