#include <iostream>
using namespace std;

int main() {
    const int N = 5;
    int v[N];
    int suma = 0;

    // Leer los 5 números
    cout << "Ingrese 5 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Sumar todos los elementos
    for (int i = 0; i < N; i++) {
        suma += v[i];
    }

    // Mostrar el resultado
    cout << "La suma total es: " << suma << endl;

    return 0;
}
