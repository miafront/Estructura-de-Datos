#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];
    int X;

    // Leer los 8 números
    cout << "Ingrese 8 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Leer el valor a buscar
    cout << "Ingrese el valor a buscar: ";
    cin >> X;

    // Buscar si X existe
    bool encontrado = false;
    for (int i = 0; i < N; i++) {
        if (v[i] == X) {
            encontrado = true;
        }
    }

    // Mostrar el resultado
    if (encontrado) {
        cout << "El valor " << X << " SI aparece en el arreglo." << endl;
    } else {
        cout << "El valor " << X << " NO aparece en el arreglo." << endl;
    }

    return 0;
}
