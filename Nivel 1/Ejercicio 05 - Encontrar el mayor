#include <iostream>
using namespace std;

int main() {
    const int N = 7;
    int v[N];

    // Leer los 7 números
    cout << "Ingrese 7 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Buscar el mayor
    int mayor = v[0];
    for (int i = 1; i < N; i++) {
        if (v[i] > mayor) {
            mayor = v[i];
        }
    }

    // Mostrar el resultado
    cout << "El mayor es: " << mayor << endl;

    return 0;
}
