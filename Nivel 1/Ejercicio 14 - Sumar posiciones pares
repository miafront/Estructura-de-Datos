#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];
    int suma = 0;

    // Leer los 8 números
    cout << "Ingrese 8 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Sumar los elementos en posiciones pares
    for (int i = 0; i < N; i += 2) {
        suma += v[i];
    }

    // Mostrar el resultado
    cout << "La suma de las posiciones pares es: " << suma << endl;

    return 0;
}
