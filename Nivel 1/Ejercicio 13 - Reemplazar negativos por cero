#include <iostream>
using namespace std;

int main() {
    const int N = 7;
    int v[N];

    // Leer los 7 números
    cout << "Ingrese 7 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Reemplazar los negativos por 0
    for (int i = 0; i < N; i++) {
        if (v[i] < 0) {
            v[i] = 0;
        }
    }

    // Mostrar el arreglo resultante
    cout << "El arreglo con negativos en cero es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
