// EJERCICIO 20: Copiar un vector
// Enunciado: Leer 6 enteros, copiarlos elemento por elemento a un segundo arreglo y mostrar la copia.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];
    int copia[N];

    cout << "Ingrese 6 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Copiar elemento por elemento
    for (int i = 0; i < N; i++) {
        copia[i] = v[i];
    }

    cout << "La copia del vector es: ";
    for (int i = 0; i < N; i++) {
        cout << copia[i] << " ";
    }
    cout << endl;

    return 0;
}
