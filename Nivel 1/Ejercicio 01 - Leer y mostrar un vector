#include <iostream>
using namespace std;

int main() {
    int v[5];

    // Leer los 5 números
    for (int i = 0; i < 5; i++) {
        cout << "Ingrese el numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Mostrarlos en el mismo orden
    cout << "Los numeros son: ";
    for (int i = 0; i < 5; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
