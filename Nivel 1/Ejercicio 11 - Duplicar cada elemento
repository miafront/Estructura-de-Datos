#include <iostream>
using namespace std;

int main() {
    const int N = 5;
    int v[N];

    // Leer los 5 números
    cout << "Ingrese 5 numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Duplicar cada elemento
    for (int i = 0; i < N; i++) {
        v[i] = v[i] * 2;
    }

    // Mostrar el arreglo resultante
    cout << "El arreglo duplicado es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
