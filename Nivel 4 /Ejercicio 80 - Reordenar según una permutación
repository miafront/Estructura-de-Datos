// EJERCICIO 80: Reordenar según una permutación
// Enunciado: Dados valores A y un arreglo P de índices, construir B tal que B[i] = A[P[i]].
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int A[N], P[N], B[N];

    cout << "Ingrese " << N << " valores del arreglo A:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "A[" << i << "]: ";
        cin >> A[i];
    }

    cout << "Ingrese " << N << " indices del arreglo P (0 a " << N - 1 << "):" << endl;
    for (int i = 0; i < N; i++) {
        cout << "P[" << i << "]: ";
        cin >> P[i];
    }

    // Construir B[i] = A[P[i]]
    for (int i = 0; i < N; i++) {
        B[i] = A[P[i]];
    }

    cout << "El arreglo B es: ";
    for (int i = 0; i < N; i++) {
        cout << B[i] << " ";
    }
    cout << endl;

    return 0;
}
