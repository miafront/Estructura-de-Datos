// EJERCICIO 63: Rotación in situ por reversas
// Enunciado: Rotar K posiciones a la derecha usando solamente intercambios/reversiones y O(1) memoria auxiliar.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];
    int K;

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese cuantas posiciones rotar a la derecha: ";
    cin >> K;
    K = K % N;

    // Reversa de un tramo [a, b]
    auto reversa = [&](int a, int b) {
        while (a < b) {
            int aux = v[a];
            v[a] = v[b];
            v[b] = aux;
            a++;
            b--;
        }
    };

    // Rotar a la derecha K: invertir todo, luego invertir [0,K-1] y [K,N-1]
    reversa(0, N - 1);
    reversa(0, K - 1);
    reversa(K, N - 1);

    cout << "El arreglo rotado es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
