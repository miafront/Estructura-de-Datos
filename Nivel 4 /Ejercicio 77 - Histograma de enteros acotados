// EJERCICIO 77: Histograma de enteros acotados
// Enunciado: Los valores estarán entre 0 y 9. Construir un arreglo de frecuencias de tamaño 10.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 10;
    int v[N];
    int frec[10] = {0}; // Inicializar todo en 0

    cout << "Ingrese " << N << " numeros (0 a 9):" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Contar frecuencias
    for (int i = 0; i < N; i++) {
        frec[v[i]]++;
    }

    cout << "Histograma:" << endl;
    for (int i = 0; i < 10; i++) {
        cout << i << ": " << frec[i] << endl;
    }

    return 0;
}
