// EJERCICIO 76: Mayor producto de tres elementos
// Enunciado: Encontrar el máximo producto posible usando tres posiciones distintas.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Buscar el mayor producto de tres posiciones distintas
    int maxProd = v[0] * v[1] * v[2];
    for (int i = 0; i < N; i++) {
        for (int j = i + 1; j < N; j++) {
            for (int k = j + 1; k < N; k++) {
                int prod = v[i] * v[j] * v[k];
                if (prod > maxProd) maxProd = prod;
            }
        }
    }

    cout << "El mayor producto de tres elementos es: " << maxProd << endl;

    return 0;
}
