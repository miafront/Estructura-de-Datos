// EJERCICIO 67: Dos números cuya suma sea X
// Enunciado: Determinar si existen dos posiciones distintas cuyos valores sumen X. Mostrar un par de índices si existe.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];
    int X;

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese la suma buscada X: ";
    cin >> X;

    // Buscar dos posiciones distintas que sumen X
    bool encontrado = false;
    for (int i = 0; i < N && !encontrado; i++) {
        for (int j = i + 1; j < N; j++) {
            if (v[i] + v[j] == X) {
                cout << "Se encontro: " << v[i] << " (indice " << i
                     << ") + " << v[j] << " (indice " << j << ") = " << X << endl;
                encontrado = true;
                break;
            }
        }
    }

    if (!encontrado) {
        cout << "No existe un par que sume " << X << "." << endl;
    }

    return 0;
}
