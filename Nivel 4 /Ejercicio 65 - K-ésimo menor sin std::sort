// EJERCICIO 65: K-ésimo menor sin std::sort
// Enunciado: Encontrar el K-ésimo menor elemento. Puede implementarse mediante selección parcial o un algoritmo equivalente sobre arreglos.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];
    int K;

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese K (1 a " << N << "): ";
    cin >> K;

    // Selección parcial: buscar el K-ésimo menor
    int copia[N];
    for (int i = 0; i < N; i++) copia[i] = v[i];

    // Ordenar copia con Bubble Sort
    for (int i = 0; i < N - 1; i++) {
        for (int j = 0; j < N - 1 - i; j++) {
            if (copia[j] > copia[j + 1]) {
                int aux = copia[j];
                copia[j] = copia[j + 1];
                copia[j + 1] = aux;
            }
        }
    }

    cout << "El " << K << "-esimo menor es: " << copia[K - 1] << endl;

    return 0;
}
