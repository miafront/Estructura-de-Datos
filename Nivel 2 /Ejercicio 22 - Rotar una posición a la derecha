// EJERCICIO 22: Rotar una posición a la derecha
// Enunciado: Desplazar todos los elementos una posición a la derecha; el último pasa a la primera posición.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Guardar el último y desplazar el resto a la derecha
    int ultimo = v[N - 1];
    for (int i = N - 1; i > 0; i--) {
        v[i] = v[i - 1];
    }
    v[0] = ultimo;

    cout << "El arreglo rotado a la derecha es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
