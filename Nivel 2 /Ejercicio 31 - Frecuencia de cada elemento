// EJERCICIO 31: Frecuencia de cada elemento
// Enunciado: Para cada valor distinto, mostrar cuántas veces aparece. No usar estructuras de datos de la STL.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Contar frecuencia de cada valor distinto
    for (int i = 0; i < N; i++) {
        // Si ya fue contado antes, saltar
        bool yaContado = false;
        for (int j = 0; j < i; j++) {
            if (v[j] == v[i]) {
                yaContado = true;
                break;
            }
        }
        if (yaContado) continue;

        // Contar cuántas veces aparece v[i]
        int contador = 0;
        for (int j = 0; j < N; j++) {
            if (v[j] == v[i]) contador++;
        }
        cout << "El valor " << v[i] << " aparece " << contador << " veces." << endl;
    }

    return 0;
}
