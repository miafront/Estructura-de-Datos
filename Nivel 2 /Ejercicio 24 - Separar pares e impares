// EJERCICIO 24: Separar pares e impares
// Enunciado: Leer N enteros y construir dos arreglos: uno con los pares y otro con los impares, preservando el orden original.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];
    int pares[N], impares[N];
    int cp = 0, ci = 0;

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Separar pares e impares
    for (int i = 0; i < N; i++) {
        if (v[i] % 2 == 0) {
            pares[cp++] = v[i];
        } else {
            impares[ci++] = v[i];
        }
    }

    cout << "Pares: ";
    for (int i = 0; i < cp; i++) {
        cout << pares[i] << " ";
    }
    cout << endl;

    cout << "Impares: ";
    for (int i = 0; i < ci; i++) {
        cout << impares[i] << " ";
    }
    cout << endl;

    return 0;
}
