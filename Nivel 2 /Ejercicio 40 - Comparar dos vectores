// EJERCICIO 40: Comparar dos vectores
// Enunciado: Determinar si dos arreglos de igual tamaño contienen exactamente los mismos valores en las mismas posiciones.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 5;
    int A[N], B[N];

    cout << "Ingrese los elementos del arreglo A:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "A[" << i << "]: ";
        cin >> A[i];
    }

    cout << "Ingrese los elementos del arreglo B:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "B[" << i << "]: ";
        cin >> B[i];
    }

    // Comparar posición por posición
    bool iguales = true;
    for (int i = 0; i < N; i++) {
        if (A[i] != B[i]) {
            iguales = false;
            break;
        }
    }

    if (iguales) {
        cout << "Los arreglos son iguales." << endl;
    } else {
        cout << "Los arreglos NO son iguales." << endl;
    }

    return 0;
}
