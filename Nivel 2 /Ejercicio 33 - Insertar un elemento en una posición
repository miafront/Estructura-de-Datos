// EJERCICIO 33: Insertar un elemento en una posición
// Enunciado: Con capacidad suficiente, insertar X en la posición P desplazando a la derecha los elementos necesarios.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int MAX = 50;
    int v[MAX];
    int N, P, X;

    cout << "Ingrese la cantidad de numeros: ";
    cin >> N;
    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese el valor a insertar: ";
    cin >> X;
    cout << "Ingrese la posicion de insercion (0 a " << N << "): ";
    cin >> P;

    // Desplazar a la derecha desde el final hasta P
    for (int i = N; i > P; i--) {
        v[i] = v[i - 1];
    }
    v[P] = X;
    N++; // Aumentar el tamaño lógico

    cout << "El arreglo con el elemento insertado es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
