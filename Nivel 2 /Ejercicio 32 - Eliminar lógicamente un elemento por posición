// EJERCICIO 32: Eliminar lógicamente un elemento por posición
// Enunciado: Leer N, el arreglo y una posición P válida. Desplazar a la izquierda desde P y reducir el tamaño lógico en uno.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int MAX = 50;
    int v[MAX];
    int N, P;

    cout << "Ingrese la cantidad de numeros: ";
    cin >> N;
    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese la posicion a eliminar (0 a " << N - 1 << "): ";
    cin >> P;

    // Desplazar a la izquierda desde P
    for (int i = P; i < N - 1; i++) {
        v[i] = v[i + 1];
    }
    N--; // Reducir el tamaño lógico

    cout << "El arreglo sin el elemento es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
