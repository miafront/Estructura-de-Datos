// EJERCICIO 28: Diferencia entre máximo y mínimo
// Enunciado: Leer N enteros y calcular máximo - mínimo.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Encontrar máximo y mínimo
    int maximo = v[0], minimo = v[0];
    for (int i = 1; i < N; i++) {
        if (v[i] > maximo) maximo = v[i];
        if (v[i] < minimo) minimo = v[i];
    }

    cout << "La diferencia (maximo - minimo) es: " << maximo - minimo << endl;

    return 0;
}

