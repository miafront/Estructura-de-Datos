// EJERCICIO 38: Comprobar si está ordenado descendentemente
// Enunciado: Determinar si cada elemento es mayor o igual que el siguiente.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Comprobar si está ordenado de mayor a menor
    bool ordenado = true;
    for (int i = 0; i < N - 1; i++) {
        if (v[i] < v[i + 1]) {
            ordenado = false;
            break;
        }
    }

    if (ordenado) {
        cout << "El arreglo SI esta ordenado descendentemente." << endl;
    } else {
        cout << "El arreglo NO esta ordenado descendentemente." << endl;
    }

    return 0;
}
