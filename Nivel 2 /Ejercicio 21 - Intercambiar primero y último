// EJERCICIO 21: Intercambiar primero y último
// Enunciado: Leer N enteros (2 ≤ N ≤ 50), intercambiar el primer elemento con el último y mostrar el arreglo.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    int N;
    cout << "Ingrese la cantidad de numeros (2 a 50): ";
    cin >> N;

    int v[50];
    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Intercambiar el primero con el último
    int aux = v[0];
    v[0] = v[N - 1];
    v[N - 1] = aux;

    cout << "El arreglo con primero y ultimo intercambiados es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
