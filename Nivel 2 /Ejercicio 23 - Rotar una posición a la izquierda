// EJERCICIO 23: Rotar una posición a la izquierda
// Enunciado: Desplazar todos los elementos una posición a la izquierda; el primero pasa a la última posición.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Guardar el primero y desplazar el resto a la izquierda
    int primero = v[0];
    for (int i = 0; i < N - 1; i++) {
        v[i] = v[i + 1];
    }
    v[N - 1] = primero;

    cout << "El arreglo rotado a la izquierda es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
