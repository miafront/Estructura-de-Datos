// EJERCICIO 35: Compactar ceros al final
// Enunciado: Mover todos los valores cero al final manteniendo el orden relativo de los no-cero.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Mover los no-cero al inicio, los ceros al final
    int pos = 0;
    for (int i = 0; i < N; i++) {
        if (v[i] != 0) {
            v[pos] = v[i];
            pos++;
        }
    }
    // Rellenar el resto con ceros
    for (int i = pos; i < N; i++) {
        v[i] = 0;
    }

    cout << "El arreglo con ceros al final es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
