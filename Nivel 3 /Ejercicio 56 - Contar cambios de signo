// EJERCICIO 56: Contar cambios de signo
// Enunciado: Contar cuántas veces dos elementos consecutivos no cero tienen signos diferentes.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Contar cambios de signo entre consecutivos no cero
    int contador = 0;
    for (int i = 0; i < N - 1; i++) {
        if (v[i] != 0 && v[i + 1] != 0) {
            // Si uno es positivo y el otro negativo
            if ((v[i] > 0 && v[i + 1] < 0) || (v[i] < 0 && v[i + 1] > 0)) {
                contador++;
            }
        }
    }

    cout << "Cantidad de cambios de signo: " << contador << endl;

    return 0;
}
