// EJERCICIO 45: Búsqueda binaria
// Enunciado: Dado un arreglo ya ordenado ascendentemente y un valor X, encontrar su índice mediante búsqueda binaria.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];
    int X;

    cout << "Ingrese " << N << " numeros enteros (ordenados ascendentemente):" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese el valor a buscar: ";
    cin >> X;

    // Búsqueda binaria
    int inicio = 0, fin = N - 1;
    int posicion = -1;
    while (inicio <= fin) {
        int medio = (inicio + fin) / 2;
        if (v[medio] == X) {
            posicion = medio;
            break;
        } else if (v[medio] < X) {
            inicio = medio + 1;
        } else {
            fin = medio - 1;
        }
    }

    if (posicion != -1) {
        cout << "El valor " << X << " esta en el indice " << posicion << "." << endl;
    } else {
        cout << "El valor " << X << " no esta en el arreglo." << endl;
    }

    return 0;
}
