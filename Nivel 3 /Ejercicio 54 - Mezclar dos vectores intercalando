// EJERCICIO 54: Mezclar dos vectores intercalando
// Enunciado: Intercalar A y B: A[0], B[0], A[1], B[1]... Si tienen distinto tamaño, anexar los sobrantes.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 5, M = 4;
    int A[N], B[M];
    int C[N + M];
    int nc = 0;

    cout << "Ingrese " << N << " elementos del arreglo A:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "A[" << i << "]: ";
        cin >> A[i];
    }
    cout << "Ingrese " << M << " elementos del arreglo B:" << endl;
    for (int i = 0; i < M; i++) {
        cout << "B[" << i << "]: ";
        cin >> B[i];
    }

    // Intercalar mientras ambos tengan elementos
    int i = 0, j = 0;
    while (i < N && j < M) {
        C[nc++] = A[i++];
        C[nc++] = B[j++];
    }
    // Anexar sobrantes de A
    while (i < N) C[nc++] = A[i++];
    // Anexar sobrantes de B
    while (j < M) C[nc++] = B[j++];

    cout << "El arreglo intercalado es: ";
    for (int k = 0; k < nc; k++) {
        cout << C[k] << " ";
    }
    cout << endl;

    return 0;
}
