// EJERCICIO 43: Ordenamiento por selección
// Enunciado: Ordenar N enteros ascendentemente con Selection Sort.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Selection Sort ascendente
    for (int i = 0; i < N - 1; i++) {
        int posMin = i;
        for (int j = i + 1; j < N; j++) {
            if (v[j] < v[posMin]) {
                posMin = j;
            }
        }
        // Intercambiar el mínimo con la posición i
        int aux = v[i];
        v[i] = v[posMin];
        v[posMin] = aux;
    }

    cout << "El arreglo ordenado es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
