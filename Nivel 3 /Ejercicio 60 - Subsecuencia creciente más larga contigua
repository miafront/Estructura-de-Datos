// EJERCICIO 60: Subsecuencia creciente más larga contigua
// Enunciado: Encontrar la mayor cantidad de elementos consecutivos estrictamente crecientes y reportar su tramo.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Buscar la subsecuencia creciente más larga
    int maxLong = 1, maxInicio = 0;
    int longActual = 1, inicioActual = 0;
    for (int i = 1; i < N; i++) {
        if (v[i] > v[i - 1]) {
            longActual++;
        } else {
            if (longActual > maxLong) {
                maxLong = longActual;
                maxInicio = inicioActual;
            }
            longActual = 1;
            inicioActual = i;
        }
    }
    // Revisar la última secuencia
    if (longActual > maxLong) {
        maxLong = longActual;
        maxInicio = inicioActual;
    }

    cout << "La subsecuencia creciente mas larga tiene " << maxLong
         << " elementos, desde el indice " << maxInicio << " hasta el " << maxInicio + maxLong - 1 << "." << endl;

    return 0;
}
