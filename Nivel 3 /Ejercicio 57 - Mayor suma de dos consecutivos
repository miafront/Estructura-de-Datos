// EJERCICIO 57: Mayor suma de dos consecutivos
// Enunciado: Encontrar el par de elementos adyacentes cuya suma sea máxima.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Buscar el par adyacente con mayor suma
    int maxSuma = v[0] + v[1];
    int pos = 0;
    for (int i = 1; i < N - 1; i++) {
        int suma = v[i] + v[i + 1];
        if (suma > maxSuma) {
            maxSuma = suma;
            pos = i;
        }
    }

    cout << "La mayor suma de dos consecutivos es: " << maxSuma
         << " (posiciones " << pos << " y " << pos + 1 << ")." << endl;

    return 0;
}
