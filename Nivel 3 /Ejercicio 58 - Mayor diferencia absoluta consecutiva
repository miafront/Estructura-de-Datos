// EJERCICIO 58: Mayor diferencia absoluta consecutiva
// Enunciado: Encontrar dos elementos consecutivos con máxima diferencia absoluta.
// Restricción: resolver sin std::vector.

#include <iostream>
#include <cmath>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Buscar la mayor diferencia absoluta entre consecutivos
    int maxDiff = abs(v[1] - v[0]);
    int pos = 0;
    for (int i = 1; i < N - 1; i++) {
        int diff = abs(v[i + 1] - v[i]);
        if (diff > maxDiff) {
            maxDiff = diff;
            pos = i;
        }
    }

    cout << "La mayor diferencia absoluta es: " << maxDiff
         << " (entre posiciones " << pos << " y " << pos + 1 << ")." << endl;

    return 0;
}
