// EJERCICIO 42: Ordenamiento burbuja descendente
// Enunciado: Ordenar N enteros de mayor a menor implementando Bubble Sort manualmente.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Bubble Sort descendente
    for (int i = 0; i < N - 1; i++) {
        for (int j = 0; j < N - 1 - i; j++) {
            if (v[j] < v[j + 1]) {
                int aux = v[j];
                v[j] = v[j + 1];
                v[j + 1] = aux;
            }
        }
    }

    cout << "El arreglo ordenado es: ";
    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}
