// EJERCICIO 49: Valores mayores que el promedio
// Enunciado: Calcular el promedio y mostrar todos los elementos estrictamente mayores al promedio.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Calcular el promedio
    int suma = 0;
    for (int i = 0; i < N; i++) {
        suma += v[i];
    }
    double promedio = (double)suma / N;

    cout << "Promedio: " << promedio << endl;
    cout << "Elementos mayores al promedio: ";
    for (int i = 0; i < N; i++) {
        if (v[i] > promedio) {
            cout << v[i] << " ";
        }
    }
    cout << endl;

    return 0;
}
