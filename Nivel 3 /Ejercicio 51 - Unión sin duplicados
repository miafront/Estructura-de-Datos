// EJERCICIO 51: Unión sin duplicados
// Enunciado: Dados A y B, construir C con todos los valores distintos que aparezcan en cualquiera de los dos arreglos.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 5;
    int A[N], B[N];
    int C[2 * N];
    int nc = 0;

    cout << "Ingrese los elementos del arreglo A:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "A[" << i << "]: ";
        cin >> A[i];
    }
    cout << "Ingrese los elementos del arreglo B:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "B[" << i << "]: ";
        cin >> B[i];
    }

    // Agregar elementos de A
    for (int i = 0; i < N; i++) {
        bool repetido = false;
        for (int j = 0; j < nc; j++) {
            if (C[j] == A[i]) { repetido = true; break; }
        }
        if (!repetido) C[nc++] = A[i];
    }

    // Agregar elementos de B que no estén ya
    for (int i = 0; i < N; i++) {
        bool repetido = false;
        for (int j = 0; j < nc; j++) {
            if (C[j] == B[i]) { repetido = true; break; }
        }
        if (!repetido) C[nc++] = B[i];
    }

    cout << "La union sin duplicados es: ";
    for (int i = 0; i < nc; i++) {
        cout << C[i] << " ";
    }
    cout << endl;

    return 0;
}
