// EJERCICIO 53: Diferencia A - B
// Enunciado: Construir un arreglo con valores distintos de A que no estén presentes en B.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 5;
    int A[N], B[N];
    int C[N];
    int nc = 0;

    cout << "Ingrese los elementos del arreglo A:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "A[" << i << "]: ";
        cin >> A[i];
    }
    cout << "Ingrese los elementos del arreglo B:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "B[" << i << "]: ";
        cin >> B[i];
    }

    // Elementos de A que NO estén en B
    for (int i = 0; i < N; i++) {
        bool estaEnB = false;
        for (int j = 0; j < N; j++) {
            if (A[i] == B[j]) { estaEnB = true; break; }
        }
        if (!estaEnB) {
            bool repetido = false;
            for (int j = 0; j < nc; j++) {
                if (C[j] == A[i]) { repetido = true; break; }
            }
            if (!repetido) C[nc++] = A[i];
        }
    }

    cout << "La diferencia A - B es: ";
    for (int i = 0; i < nc; i++) {
        cout << C[i] << " ";
    }
    cout << endl;

    return 0;
}
