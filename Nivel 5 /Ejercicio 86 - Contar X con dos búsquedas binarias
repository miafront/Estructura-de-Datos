// EJERCICIO 86: Contar X con dos búsquedas binarias
// Enunciado: Contar cuántas veces aparece X en un arreglo ordenado usando primera y última aparición, con complejidad O(log N).
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];
    int X;

    cout << "Ingrese " << N << " numeros enteros (ordenados):" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese el valor a contar: ";
    cin >> X;

    // Primera aparición
    int inicio = 0, fin = N - 1;
    int primera = -1;
    while (inicio <= fin) {
        int medio = (inicio + fin) / 2;
        if (v[medio] == X) {
            primera = medio;
            fin = medio - 1;
        } else if (v[medio] < X) {
            inicio = medio + 1;
        } else {
            fin = medio - 1;
        }
    }

    // Última aparición
    inicio = 0;
    fin = N - 1;
    int ultima = -1;
    while (inicio <= fin) {
        int medio = (inicio + fin) / 2;
        if (v[medio] == X) {
            ultima = medio;
            inicio = medio + 1;
        } else if (v[medio] < X) {
            inicio = medio + 1;
        } else {
            fin = medio - 1;
        }
    }

    if (primera != -1) {
        cout << "El valor " << X << " aparece " << ultima - primera + 1 << " veces." << endl;
    } else {
        cout << "El valor " << X << " no esta en el arreglo." << endl;
    }

    return 0;
}
