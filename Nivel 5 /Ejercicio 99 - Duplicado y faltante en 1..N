// EJERCICIO 99: Duplicado y faltante en 1..N
// Enunciado: El arreglo contiene números de 1..N, pero uno está repetido y otro falta. Determinar ambos sin usar contenedores STL.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros (de 1 a " << N << ", uno repetido):" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Contar apariciones con arreglo de frecuencias
    int frec[N + 1] = {0};
    int duplicado = -1;

    for (int i = 0; i < N; i++) {
        frec[v[i]]++;
        if (frec[v[i]] == 2) duplicado = v[i];
    }

    // Buscar el que falta
    int faltante = -1;
    for (int i = 1; i <= N; i++) {
        if (frec[i] == 0) {
            faltante = i;
            break;
        }
    }

    cout << "Duplicado: " << duplicado << endl;
    cout << "Faltante: " << faltante << endl;

    return 0;
}
