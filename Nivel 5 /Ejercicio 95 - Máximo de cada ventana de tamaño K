// EJERCICIO 95: Máximo de cada ventana de tamaño K
// Enunciado: Para cada ventana consecutiva de K elementos, mostrar el máximo usando una cola doble manual basada en arreglo de índices.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];
    int K;

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese el tamaño de la ventana K: ";
    cin >> K;

    // Deque manual: arreglo de índices
    int deque[N];
    int frente = 0, final = -1;

    cout << "Maximos de cada ventana: ";
    for (int i = 0; i < N; i++) {
        // Quitar elementos fuera de la ventana
        while (frente <= final && deque[frente] <= i - K) frente++;

        // Quitar elementos menores al actual (no son candidatos)
        while (frente <= final && v[deque[final]] <= v[i]) final--;

        deque[++final] = i;

        // Cuando la ventana está completa, mostrar el máximo
        if (i >= K - 1) {
            cout << v[deque[frente]] << " ";
        }
    }
    cout << endl;

    return 0;
}
