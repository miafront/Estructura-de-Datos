// EJERCICIO 87: Elemento mayoritario
// Enunciado: Determinar si existe un valor que aparezca más de N/2 veces. Implementar Boyer-Moore y verificar el candidato.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // Boyer-Moore: encontrar candidato
    int candidato = v[0];
    int contador = 1;
    for (int i = 1; i < N; i++) {
        if (contador == 0) {
            candidato = v[i];
            contador = 1;
        } else if (v[i] == candidato) {
            contador++;
        } else {
            contador--;
        }
    }

    // Verificar si el candidato es mayoritario
    int apariciones = 0;
    for (int i = 0; i < N; i++) {
        if (v[i] == candidato) apariciones++;
    }

    if (apariciones > N / 2) {
        cout << "El elemento mayoritario es: " << candidato << endl;
    } else {
        cout << "No existe elemento mayoritario." << endl;
    }

    return 0;
}
