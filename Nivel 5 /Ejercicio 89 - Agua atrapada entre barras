// EJERCICIO 89: Agua atrapada entre barras
// Enunciado: Cada elemento representa una altura. Calcular cuánta agua queda atrapada después de llover.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];

    cout << "Ingrese " << N << " alturas:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Altura " << i + 1 << ": ";
        cin >> v[i];
    }

    // Para cada posición, el agua = min(maxIzq, maxDer) - altura
    int total = 0;
    for (int i = 1; i < N - 1; i++) {
        int maxIzq = v[0];
        for (int j = 0; j < i; j++) {
            if (v[j] > maxIzq) maxIzq = v[j];
        }
        int maxDer = v[N - 1];
        for (int j = i + 1; j < N; j++) {
            if (v[j] > maxDer) maxDer = v[j];
        }
        int nivel = (maxIzq < maxDer ? maxIzq : maxDer);
        if (nivel > v[i]) total += nivel - v[i];
    }

    cout << "El agua atrapada es: " << total << endl;

    return 0;
}
