#include <iostream>
using namespace std;

// Ejercicio 81. QuickSort con arreglos
// Enunciado: Implementar QuickSort recursivo sobre un arreglo de enteros,
// sin std::sort ni std::vector.
// Restricción: resolver sin std::vector.

void quicksort(int v[], int inicio, int fin) {
    if (inicio >= fin) return;          // si no hay nada, corto

    int pivote = v[fin];                // el último es el "jefe"
    int i = inicio - 1;

    for (int j = inicio; j < fin; j++) {
        if (v[j] < pivote) {            // si es menor que el jefe
            i++;
            swap(v[i], v[j]);           // lo mando a la izquierda
        }
    }

    swap(v[i + 1], v[fin]);             // el jefe a su lugar

    quicksort(v, inicio, i);            // ordeno la izquierda
    quicksort(v, i + 2, fin);           // ordeno la derecha
}

int main() {
    int v[] = {5, 2, 8, 1, 9, 3, 6};
    int N = 7;

    quicksort(v, 0, N - 1);

    for (int i = 0; i < N; i++) {
        cout << v[i] << " ";
    }
    cout << endl;

    return 0;
}


