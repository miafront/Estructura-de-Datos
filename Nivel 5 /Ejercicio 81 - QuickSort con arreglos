// EJERCICIO 81: QuickSort con arreglos
// Enunciado: Implementar QuickSort recursivo sobre un arreglo de enteros, sin std::sort ni std::vector.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

// Función que particiona y devuelve la posición del pivote
int particion(int v[], int bajo, int alto) {
    int pivote = v[alto];
    int i = bajo - 1;

    for (int j = bajo; j < alto; j++) {
        if (v[j] <= pivote) {
            i++;
            int aux = v[i];
            v[i] = v[j];
            v[j] = aux;
        }
    }
    // Colocar el pivote en su posición final
    int aux = v[i + 1];
    v[i + 1] = v[alto];
    v[alto] = aux;
    return i + 1;
}

