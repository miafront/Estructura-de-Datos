// EJERCICIO 98: Número faltante en 0..N
// Enunciado: Se reciben N valores distintos del rango 0..N; falta exactamente uno. Encontrarlo sin ordenar, usando suma o XOR.
// Restricción: resolver sin std::vector。



#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int v[N];

    cout << "Ingrese " << N << " numeros distintos (de 0 a " << N << "):" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    // XOR de todos los números de 0 a N
    int xorTotal = 0;
    for (int i = 0; i <= N; i++) xorTotal ^= i;

    // XOR con los elementos del arreglo: lo que queda es el faltante
    for (int i = 0; i < N; i++) xorTotal ^= v[i];

    cout << "El numero faltante es: " << xorTotal << endl;

    return 0;
}
