// EJERCICIO 88: Producto excepto en la posición
// Enunciado: Construir R donde R[i] sea el producto de todos los elementos excepto A[i]. No usar división.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 6;
    int A[N];
    int R[N];

    cout << "Ingrese " << N << " numeros enteros:" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> A[i];
    }

    // Para cada posición, multiplicar todos excepto A[i]
    for (int i = 0; i < N; i++) {
        int producto = 1;
        for (int j = 0; j < N; j++) {
            if (j != i) producto *= A[j];
        }
        R[i] = producto;
    }

    cout << "El arreglo R es: ";
    for (int i = 0; i < N; i++) {
        cout << R[i] << " ";
    }
    cout << endl;

    return 0;
}
