// EJERCICIO 96: Longitud mínima con suma al menos S
// Enunciado: Con valores positivos, hallar la longitud mínima de un subarreglo contiguo cuya suma sea ≥ S.
// Restricción: resolver sin std::vector.

#include <iostream>
using namespace std;

int main() {
    const int N = 8;
    int v[N];
    int S;

    cout << "Ingrese " << N << " numeros enteros (positivos):" << endl;
    for (int i = 0; i < N; i++) {
        cout << "Numero " << i + 1 << ": ";
        cin >> v[i];
    }

    cout << "Ingrese la suma minima S: ";
    cin >> S;

    // Ventana deslizante: dos punteros
    int inicio = 0, suma =  ​0;
    int minLong = N + 1;

    for (int fin = 0; fin < N; fin++) {
        suma += v[fin];

        // Reducir la ventana mientras la suma siga siendo ≥ S
        while (suma >= S) {
            int largo = fin - inicio + 1;
            if (largo < minLong) minLong = largo;
            suma -= v[inicio];
            inicio++;
        }
    }

    if (minLong == N + 1) {
        cout << "No existe subarreglo con suma al menos " << S << "." << endl;
    } else {
        cout << "La longitud minima es: " << minLong << endl;
    }

    return 0;
}
