
#include <iostream>
using namespace std;

class DoublyList {
private:
    // Estructura de cada nodo
    struct Node {
        int value;
        Node* next;
        Node* prev;

        // Inicializa el valor y los dos punteros
        Node(int v) : value(v), next(nullptr), prev(nullptr) {}
    };

    Node* head;  // Primer nodo
    Node* tail;  // Último nodo

public:
    // Constructor: crea una lista vacía
    DoublyList() : head(nullptr), tail(nullptr) {}

    // Destructor: libera la memoria de todos los nodos
    ~DoublyList() {
        Node* current = head;

        while (current != nullptr) {
            Node* temp = current;       // Guarda el nodo actual
            current = current->next;    // Avanza al siguiente
            delete temp;                // Elimina el nodo anterior
        }
    }

    // Añade un nodo al final
    void append(int value) {
        Node* newNode = new Node(value);

        if (head == nullptr) {
            head = newNode;
            tail = newNode;
        } else {
            newNode->prev = tail;
            tail->next = newNode;
            tail = newNode;
        }
    }

    // Imprime desde la cabeza hasta la cola
    void printForward() const {
        Node* current = head;

        if (current == nullptr)
            cout << "(vacia)";

        while (current != nullptr) {
            cout << current->value;
            if (current->next != nullptr)
                cout << " <-> ";

            current = current->next;
        }

        cout << '\n';
    }

    // Imprime desde la cola hasta la cabeza
    void printBackward() const {
        Node* current = tail;

        if (current == nullptr)
            cout << "(vacia)";

        while (current != nullptr) {
            cout << current->value;
            if (current->prev != nullptr)
                cout << " <-> ";

            current = current->prev;
        }

        cout << '\n';
    }

    // Fusiona dos listas ordenadas reutilizando sus nodos
    void mergeFrom(DoublyList& a, DoublyList& b) {
        Node* p = a.head;  // Recorre A
        Node* q = b.head;  // Recorre B

        while (p != nullptr || q != nullptr) {
            Node* chosen;

            // Escoge el menor nodo disponible
            if (q == nullptr ||
                (p != nullptr && p->value <= q->value)) {
                chosen = p;
                p = p->next;
            } else {
                chosen = q;
                q = q->next;
            }

            // Conecta el nodo elegido al final del resultado
            chosen->prev = tail;
            chosen->next = nullptr;

            if (tail != nullptr)
                tail->next = chosen;
            else
                head = chosen;

            tail = chosen;
        }

        // A y B ya no poseen los nodos transferidos
        a.head = nullptr;
        a.tail = nullptr;
        b.head = nullptr;
        b.tail = nullptr;
    }

    // Verifica los enlaces y el orden ascendente
    bool verify() const {
        Node* previous = nullptr;
        Node* current = head;

        // Comprueba el recorrido hacia adelante
        while (current != nullptr) {
            if (current->prev != previous)
                return false;

            if (previous != nullptr &&
                previous->value > current->value)
                return false;

            previous = current;
            current = current->next;
        }

        if (previous != tail)
            return false;

        Node* nextNode = nullptr;
        current = tail;

        // Comprueba el recorrido hacia atrás
        while (current != nullptr) {
            if (current->next != nextNode)
                return false;

            if (nextNode != nullptr &&
                current->value > nextNode->value)
                return false;

            nextNode = current;
            current = current->prev;
        }

        return nextNode == head;
    }

    // Comprueba si la lista está vacía
    bool isEmpty() const {
        return head == nullptr;
    }

    // Devuelve el valor de la cabeza; requiere una lista no vacía
    int getHeadValue() const {
        return head->value;
    }

    // Devuelve el valor de la cola; requiere una lista no vacía
    int getTailValue() const {
        return tail->value;
    }
};

int main() {
    DoublyList A, B, result;
    int n, m, value;

    // Solicita la cantidad de elementos de A
    cout << "Cantidad de elementos de A: ";
    cin >> n;

    cout << "Ingresa los elementos de A en orden ascendente:\n";
    for (int i = 0; i < n; i++) {
        cin >> value;
        A.append(value);
    }

    // Solicita la cantidad de elementos de B
    cout << "Cantidad de elementos de B: ";
    cin >> m;

    cout << "Ingresa los elementos de B en orden ascendente:\n";
    for (int i = 0; i < m; i++) {
        cin >> value;
        B.append(value);
    }

    // Muestra las listas originales
    cout << "\nLista A: ";
    A.printForward();

    cout << "Lista B: ";
    B.printForward();

    // Fusiona A y B en result
    result.mergeFrom(A, B);

    // Muestra el resultado en ambos sentidos
    cout << "\nLista fusionada hacia adelante: ";
    result.printForward();

    cout << "Lista fusionada hacia atras: ";
    result.printBackward();

    // Verifica la lista resultante
    if (result.verify())
        cout << "Verificacion correcta.\n";
    else
        cout << "Error en los enlaces o el orden.\n";

    return 0;
}
